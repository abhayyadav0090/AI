# Copy to .env for local use. On Render, add these under Environment.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nexos

# Long random string used to sign sign-in cookies (for example: openssl rand -hex 32)
JWT_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your site URL under "Authorized JavaScript origins", for example https://your-app.onrender.com
GOOGLE_CLIENT_ID=

# Google AI Studio API key for NexAI
GEMINI_API_KEY=

# Optional: extra origins allowed to call the API (comma separated). The app's own address always works.
ALLOWED_ORIGINS=

# Optional: task reminder push notifications. Create keys with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
